# Copy to .cloudflare.env and fill in credentials (never commit .cloudflare.env)
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id
CF_PAGES_PROJECT=tbseo
CF_D1_DATABASE=tbseo
CF_R2_BUCKET=tbseo

# Cloudflare Pages → Settings → Environment variables (Production):
# NUXT_PUBLIC_SITE_URL=https://tailorboost.com
# NUXT_PUBLIC_USE_R2_MEDIA=true
# SKIP_DEPENDENCY_INSTALL=1
# NITRO_PRESET=cloudflare_pages
# NODE_VERSION=22
# NODE_OPTIONS=--max-old-space-size=4096
# GITHUB_TOKEN=<token with repo read access to guxingbiao0507/nuxtcms>
#
# Build command (Settings → Builds):
#   bash scripts/cf-pages-install.sh && pnpm run cf:build
# Build output directory: dist
# Node.js version: 20
