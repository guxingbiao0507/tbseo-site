{
  "name": "tbseo-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cf": "cross-env NITRO_PRESET=cloudflare_pages nuxt build && node node_modules/nuxtcms/scripts/patch-worker.mjs",
    "cf:build": "node scripts/cf-pages-build.mjs",
    "deploy": "node node_modules/nuxtcms/scripts/deploy.mjs",
    "deploy:migrate": "node node_modules/nuxtcms/scripts/deploy.mjs --migrate",
    "import:blog": "node scripts/import-tailorboost-blog.mjs",
    "import:blog:replace": "node scripts/import-tailorboost-blog.mjs --replace",
    "download:images": "node scripts/download-theme-images.mjs",
    "sync:assets": "node scripts/sync-local-assets.mjs",
    "upload:r2": "node scripts/upload-public-to-r2.mjs",
    "configure:cf": "node scripts/configure-cf-pages.mjs",
    "deploy:all": "node scripts/deploy-with-r2.mjs",
    "install:admin": "node scripts/install-admin.mjs",
    "seed:d1": "node scripts/seed-d1-remote.mjs",
    "postinstall": "nuxt prepare"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/mdc": "^0.22.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "nuxt": "^4.4.8",
    "nuxt-auth-utils": "^0.5.29",
    "nuxtcms": "git+https://github.com/guxingbiao0507/nuxtcms.git",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@adonisjs/hash": "^10.1.0",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@nuxt/content": "^3.15.0",
    "@nuxtjs/i18n": "^10.4.1",
    "@nuxtjs/seo": "^5.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.18.1",
    "wrangler": "^4.110.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.141.0",
    "@oxc-transform/binding-linux-x64-gnu": "0.141.0",
    "@oxc-minify/binding-linux-x64-gnu": "0.141.0",
    "@rolldown/binding-linux-x64-gnu": "1.2.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  }
}
